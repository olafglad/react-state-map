{
  "name": "@react-state-map/cli",
  "version": "0.2.0",
  "description": "Visualize React state flow with interactive graph — ELK.js layout, canvas rendering, semantic zoom, fuzzy search, path-finding, and prop drilling detection",
  "type": "module",
  "license": "MIT",
  "author": "Olaf Glad",
  "repository": {
    "type": "git",
    "url": "https://github.com/olafglad/react-state-map"
  },
  "homepage": "https://github.com/olafglad/react-state-map#readme",
  "bin": {
    "react-state-map": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc && cp src/renderers/dagre.bundle.js src/renderers/elk.bundle.js src/renderers/cytoscape.bundle.js dist/renderers/",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@react-state-map/core": "workspace:*",
    "chokidar": "^3.5.3",
    "commander": "^12.0.0",
    "cytoscape": "^3.30.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.3.0"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "keywords": [
    "react",
    "state",
    "visualization",
    "static-analysis",
    "cli",
    "react-hooks",
    "prop-drilling",
    "state-management",
    "graph",
    "elkjs",
    "cytoscape",
    "context",
    "redux",
    "zustand",
    "component-diagram"
  ]
}
